[
  {
    "id": "diag:penetration",
    "symptom": "薄布穿透/自接触遗漏",
    "claim_ids": [
      "c:margin",
      "c:capacity",
      "c:dat"
    ],
    "plan": [
      "先确认接触类别与 initial intersection；检查候选覆盖、尺度、margin/gap、primitive filters 与容量",
      "固定材料，比较更密检测/更小 dt；观察穿透深度和候选数量，再单独增加迭代"
    ],
    "metrics": [
      "max penetration",
      "candidate counts/capacity",
      "dt",
      "iterations"
    ],
    "caution": "不能只靠加大 ke 或 iterations",
    "status": "proposed_diagnostic_plan_not_measured_experience",
    "version": "1.7.0"
  },
  {
    "id": "diag:slip",
    "symptom": "抓取滑落",
    "claim_ids": [
      "c:friction",
      "c:observable",
      "c:attachment"
    ],
    "plan": [
      "核对真实夹紧位移/控制、两侧接触法向和接触几何",
      "分开扫描材料 mu、摩擦平滑阈值和法向刚度；保持执行轨迹相同"
    ],
    "metrics": [
      "slip displacement",
      "contact wrench",
      "object pose error"
    ],
    "caution": "不能以 attachment 或人为位置锁定宣称恢复真实摩擦抓取",
    "status": "proposed_diagnostic_plan_not_measured_experience",
    "version": "1.7.0"
  },
  {
    "id": "diag:soft",
    "symptom": "材料太软/关节漂移",
    "claim_ids": [
      "c:alm_math",
      "c:legacy",
      "c:cache"
    ],
    "plan": [
      "先分离物理材料、结构刚度、drive 参数与数值收敛",
      "固定物理参数增加预算检查解是否收敛，再改变材料并比较静态形变"
    ],
    "metrics": [
      "static deflection",
      "joint residual",
      "runtime"
    ],
    "caution": "外观变硬不等于已识别真实刚度",
    "status": "proposed_diagnostic_plan_not_measured_experience",
    "version": "1.7.0"
  },
  {
    "id": "diag:oscillation",
    "symptom": "抖动或过度阻尼",
    "claim_ids": [
      "c:damping",
      "c:friction",
      "c:implicit"
    ],
    "plan": [
      "核对阻尼量纲和模型尺度；不要套用旧版 tri_kd 经验",
      "固定物理参数分别扫 dt 和 iterations，再扫材料 damping；记录相位、幅度和静态形变"
    ],
    "metrics": [
      "amplitude decay",
      "phase error",
      "kinetic energy"
    ],
    "caution": "数值耗散与物理阻尼可能混淆",
    "status": "proposed_diagnostic_plan_not_measured_experience",
    "version": "1.7.0"
  },
  {
    "id": "diag:coupling",
    "symptom": "刚体未受软体反力影响",
    "claim_ids": [
      "c:external"
    ],
    "plan": [
      "确认是否启用 external rigid 单向模式",
      "需要双向时选统一 VBD 或审查专门 coupled solver 数据交换与力反馈"
    ],
    "metrics": [
      "two-side momentum change",
      "contact force",
      "coupling schedule"
    ],
    "caution": "单个 True 选项不会自动创建反力闭环",
    "status": "proposed_diagnostic_plan_not_measured_experience",
    "version": "1.7.0"
  },
  {
    "id": "diag:reset",
    "symptom": "复位后突然跳动",
    "claim_ids": [
      "c:reset",
      "c:history"
    ],
    "plan": [
      "同时核对模型默认位姿与 episode 位姿",
      "reset 后重做 FK/碰撞并清除 pipeline matching 历史，再进入固定步长"
    ],
    "metrics": [
      "first-step displacement",
      "history validity"
    ],
    "caution": "状态重置不能保留过期接触对应关系",
    "status": "proposed_diagnostic_plan_not_measured_experience",
    "version": "1.7.0"
  },
  {
    "id": "diag:performance",
    "symptom": "迭代慢/显存或容量不足",
    "claim_ids": [
      "c:capacity",
      "c:tile",
      "c:schedule"
    ],
    "plan": [
      "把 JIT 编译排除出稳态计时，记录设备和 Warp 版本",
      "记录 mesh/颜色数、候选数、buffer 与检测频率；比较 tile 路径但保持物理配置"
    ],
    "metrics": [
      "steady step ms",
      "memory",
      "contact overflow",
      "color count"
    ],
    "caution": "不要靠默默漏检获得速度",
    "status": "proposed_diagnostic_plan_not_measured_experience",
    "version": "1.7.0"
  },
  {
    "id": "diag:dat_config",
    "symptom": "刚柔 DAT 构造失败",
    "claim_ids": [
      "c:rigid_dat_requires"
    ],
    "plan": [
      "检查 solver-owned pipeline、external-rigid 开关与正的最小查询半径",
      "按报错修正配置后运行密集接触用例；不是放宽所有校验"
    ],
    "metrics": [
      "constructor error",
      "query radius",
      "contact schedule"
    ],
    "caution": "参数通过校验不等于几何鲁棒性已验证",
    "status": "proposed_diagnostic_plan_not_measured_experience",
    "version": "1.7.0"
  }
]
